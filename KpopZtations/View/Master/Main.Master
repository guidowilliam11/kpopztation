<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main.master.cs" Inherits="KpopZtations.View.Master.Main" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>KpopZtations</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.1.4/swiper-bundle.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dDPink: '#BF0132',
                        dPink: '#D80038',
                        lPink: '#FFDDE6',
                        dBlue: '#0F183E',
                        lBlue: '#272E4B',
                        ink2: '#4B5270',
                        ink3: '#7C8199',
                        line: '#E7E3E8',
                        canvas: '#FBF9FA',
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                    },
                    fontSize: {
                        title: '2.25rem',
                        heading: '1.3125rem',
                        subheading: '1.125rem',
                        name: '1rem',
                        subname: '0.875rem',
                    },
                    borderRadius: {
                        'default': '5px',
                    },
                }
            }
        }
    </script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="overflow-x-hidden bg-canvas text-dBlue font-sans antialiased">
    <form id="form1" runat="server">
        <nav class="navbar sticky top-0 z-50">
            <ul class="bg-white/95 backdrop-blur border-b border-line">
                <asp:Panel ID="loginPanelGuest" runat="server" Visible='<%# ShowElementByGuest() %>' class="max-w-6xl mx-auto px-6 min-h-16 py-3 flex flex-wrap gap-x-6 gap-y-2 justify-between items-center">
                    <asp:LinkButton runat="server" ID="homeBtn" class="text-dPink font-bold text-xl tracking-tight" OnClick="homeBtn_Click">KpopZtation</asp:LinkButton>
                    <div class="flex gap-2 items-center">
                        <asp:LinkButton runat="server" ID="loginBtn" OnClick="loginBtn_Click" class="text-sm text-dBlue font-medium px-4 py-2 rounded-md hover:bg-lPink/60">Login</asp:LinkButton>
                        <asp:LinkButton runat="server" ID="registerBtn" OnClick="registerBtn_Click" class="text-sm text-white font-medium bg-dPink px-4 py-2 rounded-md hover:bg-dDPink">Register</asp:LinkButton>
                    </div>
                </asp:Panel>
                <asp:Panel ID="loginPanelCustomer" runat="server" Visible='<%# ShowElementByCustomer() %>' class="max-w-6xl mx-auto px-6 min-h-16 py-3 flex flex-wrap gap-x-6 gap-y-2 justify-between items-center">
                    <asp:LinkButton runat="server" ID="LinkButton2" class="text-dPink font-bold text-xl tracking-tight" OnClick="homeBtn_Click">KpopZtation</asp:LinkButton>
                    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
                        <asp:LinkButton runat="server" ID="cartBtn" OnClick="cartBtn_Click" CssClass="text-ink2 hover:text-dBlue transition-colors duration-100">Cart</asp:LinkButton>
                        <asp:LinkButton runat="server" ID="trHistoryBtn" OnClick="trHistoryBtn_Click" CssClass="text-ink2 hover:text-dBlue transition-colors duration-100">Transaction History</asp:LinkButton>
                        <asp:LinkButton runat="server" ID="updateProfileBtn" OnClick="updateProfileBtn_Click" CssClass="text-ink2 hover:text-dBlue transition-colors duration-100">Update Profile</asp:LinkButton>
                        <asp:LinkButton runat="server" ID="logout" OnClick="logout_Click" CssClass="text-ink2 hover:text-dBlue transition-colors duration-100">Logout</asp:LinkButton>
                    </div>
                </asp:Panel>
                <asp:Panel ID="loginPanelAdmin" runat="server" Visible='<%# ShowElementByAdmin() %>' class="max-w-6xl mx-auto px-6 min-h-16 py-3 flex flex-wrap gap-x-6 gap-y-2 justify-between items-center">
                    <asp:LinkButton runat="server" ID="LinkButton3" class="text-dPink font-bold text-xl tracking-tight" OnClick="homeBtn_Click">KpopZtation</asp:LinkButton>
                    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
                        <asp:LinkButton runat="server" ID="trReportBtn" OnClick="trReportBtn_Click" CssClass="text-ink2 hover:text-dBlue transition-colors duration-100">Transaction Report</asp:LinkButton>
                        <asp:LinkButton runat="server" OnClick="updateProfileBtn_Click" CssClass="text-ink2 hover:text-dBlue transition-colors duration-100">Update Profile</asp:LinkButton>
                        <asp:LinkButton runat="server" ID="LinkButton1" OnClick="logout_Click" CssClass="text-ink2 hover:text-dBlue transition-colors duration-100">Logout</asp:LinkButton>
                    </div>
                </asp:Panel>
            </ul>
        </nav>
        <div class="w-full">
            <asp:ContentPlaceHolder ID="AuthForm" runat="server"></asp:ContentPlaceHolder>
        </div>
        <div class="max-w-6xl mx-auto px-6 pb-16">
            <asp:ContentPlaceHolder ID="body" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11.1.4/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flowbite@2.3.0/dist/flowbite.min.js"></script>
    <script>
        // Every album row on a page scrolls sideways: drag, swipe or the arrow buttons.
        document.querySelectorAll('.album-swiper').forEach(function (el) {
            new Swiper(el, {
                slidesPerView: 2.2, spaceBetween: 16, grabCursor: true,
                navigation: { nextEl: el.parentElement.querySelector('.swiper-next'), prevEl: el.parentElement.querySelector('.swiper-prev') },
                breakpoints: { 640: { slidesPerView: 3.2 }, 1024: { slidesPerView: 5, spaceBetween: 20 } }
            });
        });
    </script>
</body>
</html>
